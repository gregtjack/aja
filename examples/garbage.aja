// Garbage collection: memory is managed for you, including cycles.
//
// Each call to `countdown` builds a closure that calls itself through the
// variable it is bound to, which it captures: a reference cycle. The collector frees
// these, so memory stays flat however many are made. On macOS, compare the
// peak memory of a run with:
//
//     /usr/bin/time -l cargo run --release -- examples/garbage.aja

fn countdown(from: int) -> int {
    let step = fn(n: int) -> int { if n == 0 { 0 } else { 1 + step(n - 1) } };
    step(from)
}

fn main() {
    let start = clock();
    var total = 0;
    var i = 0;
    while i < 1_000_000 {
        total = total + countdown(3);
        i = i + 1;
    }
    println("made a million self-referencing closures, counted", total, "steps");
    println("took", clock() - start, "ms");
}
