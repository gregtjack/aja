// A small HTTP server, on `std::http`, which reads the requests, writes
// the responses, and gives each connection a task of its own.
//
//     cargo run -- examples/net/http_server.aja [port]
//     curl http://127.0.0.1:8080/
//     curl http://127.0.0.1:8080/hello?name=Ada
//     curl -d 'some text' http://127.0.0.1:8080/echo
//     curl http://127.0.0.1:8080/count
//
// The port is the first argument, or else $PORT, or else 8080.
//
// The hit counter is shared state, and the handler runs in each
// connection's task, so one task owns the counter and the handler sends it
// requests over a channel.

import std::channel;
import std::collections::{Map};
import std::env;
import std::http::{Request, Response};
import std::http;
import std::io;
import std::net;
import std::task;

// ---- The hit counter, owned by one task ---------------------------------------

enum Counter {
    Hit(str),
    Get(channel::Sender<List<(str, int)>>),
}

fn run_counter(inbox: channel::Receiver<Counter>) {
    var hits: Map<str, int> = Map::new();
    for msg in inbox {
        match msg {
            Counter::Hit(path) => {
                hits = hits.update(path, fn(n) { Some(n.unwrap_or(0) + 1) });
            }
            Counter::Get(reply) => {
                let _ = reply.send(hits.to_list().sort());
            }
        }
    }
}

// ---- Routing --------------------------------------------------------------------

fn escape_html(s: str) -> str {
    s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

fn route(req: Request, counter: channel::Sender<Counter>) -> Response {
    let _ = counter.send(Counter::Hit(req.path));
    match (req.method, req.path) {
        ("GET", "/") => Response::html(200,
            "<!doctype html><title>Aja</title><h1>Hello from Aja</h1>"
            + "<ul><li><a href=\"/hello?name=world\">/hello</a></li>"
            + "<li><a href=\"/count\">/count</a></li>"
            + "<li><a href=\"/headers\">/headers</a></li></ul>\n"),
        ("GET", "/hello") => {
            let name = req.query.get("name").unwrap_or("stranger");
            Response::text(200, "Hello, {name}!\n")
        }
        ("GET", "/headers") => {
            let lines = req.headers.to_list().sort().map(fn(h) { "{h.0}: {h.1}" });
            Response::text(200, "\n".join(lines) + "\n")
        }
        ("GET", "/count") => {
            let (reply, answer) = channel::new(0);
            let _ = counter.send(Counter::Get(reply));
            let counts = answer.recv().unwrap_or([]);
            let lines = counts.map(fn(c) { "{c.1}\t{escape_html(c.0)}" });
            Response::html(200, "<pre>" + "\n".join(lines) + "</pre>\n")
        }
        ("POST", "/echo") => Response::text(200, req.body),
        (_, "/" | "/hello" | "/headers" | "/count" | "/echo") =>
            Response::text(405, "method {req.method} not allowed on {req.path}\n"),
        _ => Response::text(404, "no page at {req.path}\n"),
    }
}

fn main() -> Result<void, io::Error> {
    let port = env::args().first().or(env::get("PORT")).unwrap_or("8080");
    let listener = net::listen("127.0.0.1:{port}")?;
    println("listening on http://{listener.local_addr()}");
    let (counter, inbox) = channel::new(64);
    task::scope(fn(s) {
        s.spawn(fn() { run_counter(inbox) });
        http::serve(listener, fn(req: Request) -> Response {
            let res = route(req, counter);
            println("{req.peer} {req.method} {req.path} -> {res.status}");
            res
        });
    });
    Ok(void)
}
