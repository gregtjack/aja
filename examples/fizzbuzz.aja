// FizzBuzz: loops, arithmetic, and nested `if` / `else`.

fn fizzbuzz(n: int) -> str {
    if n % 15 == 0 {
        "FizzBuzz"
    } else {
        if n % 3 == 0 {
            "Fizz"
        } else {
            if n % 5 == 0 { "Buzz" } else { "" }
        }
    }
}

fn main() {
    var i = 1;
    while i <= 20 {
        let word = fizzbuzz(i);
        if word == "" {
            println(i);
        } else {
            println(word);
        }
        i = i + 1;
    }
}
