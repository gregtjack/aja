// A generic function must work for every type, so its body can't assume
// anything about a type parameter.
//
// expect: cannot apply '+' to T and T
// expect: match arms have incompatible types: T and int
// expect: mismatched types: 'names' is declared as Option<str> but was given Option<int>

fn add<T>(a: T, b: T) -> T {
    a + b
}

fn first_or_zero<T>(o: Option<T>) -> T {
    match o {
        Some(x) => x,
        None => 0,
    }
}

fn main() {
    let names: Option<str> = Some(42);
}
