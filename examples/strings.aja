// Strings: `+` joins two of them into a new one. Strings live on the
// garbage-collected heap like everything else, so the ones a program stops
// using are freed, and big strings count for more than small ones when the
// collector decides it's time to run.
//
// There are no implicit conversions: `"n = " + 1` is a type error.

struct Person { name: str, title: str }

fn greet(p: Person) -> str {
    "Hello, " + p.title + " " + p.name + "!"
}

fn repeat(s: str, times: int) -> str {
    var out = "";
    var i = 0;
    while i < times { out = out + s; i = i + 1; }
    out
}

fn main() {
    let lovelace = Person {
        name: "Lovelace",
        title: "Countess"
    };
    println(greet(lovelace));
    println(repeat("ab", 3) == "ababab");

    // Builds a 64 KiB string ten thousand times (about 640 MB in all) and
    // throws each one away. Memory stays flat, because the collector frees
    // the old ones. On macOS, see the peak memory with:
    //
    //     /usr/bin/time -l cargo run --release -- examples/strings.aja
    let block = repeat("0123456789abcdef", 4096);
    var i = 0;
    while i < 10_000 {
        let copy = block + "#";
        i = i + 1;
    }
    println("built", i, "strings of 64 KiB each");
}
