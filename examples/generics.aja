// Generics: functions, structs, and enums can take type parameters, written
// in angle brackets. Type arguments are inferred where the code is used, so
// `Some(1)` is an `Option<int>` without saying so. (`Option` comes from the
// prelude; see results.aja.)

struct Pair<A, B> { first: A, second: B }

enum Chain<T> {
    Nil,
    Cons(T, Chain<T>),
}

// A generic function works for every type its caller chooses. Its body
// can't assume anything about `T`, so it can only pass values of it around.
fn swap<A, B>(p: Pair<A, B>) -> Pair<B, A> {
    Pair { first: p.second, second: p.first }
}

fn map<T, U>(xs: Chain<T>, f: (T) -> U) -> Chain<U> {
    match xs {
        Chain::Nil => Chain::Nil,
        Chain::Cons(x, rest) => Chain::Cons(f(x), map(rest, f)),
    }
}

fn fold<T, A>(xs: Chain<T>, acc: A, f: (A, T) -> A) -> A {
    match xs {
        Chain::Nil => acc,
        Chain::Cons(x, rest) => fold(rest, f(acc, x), f),
    }
}

fn find<T>(xs: Chain<T>, wanted: (T) -> bool) -> Option<T> {
    match xs {
        Chain::Nil => None,
        Chain::Cons(x, _) if wanted(x) => Some(x),
        Chain::Cons(_, rest) => find(rest, wanted),
    }
}

fn unwrap_or<T>(o: Option<T>, default: T) -> T {
    match o {
        Some(x) => x,
        None => default,
    }
}

fn main() {
    let p = swap(Pair { first: 1, second: "one" });
    println(p.first, p.second);

    let xs = Chain::Cons(1, Chain::Cons(2, Chain::Cons(3, Chain::Cons(4, Chain::Nil))));
    let squares = map(xs, fn(x) { x * x });
    println("sum of squares:", fold(squares, 0, fn(acc, x) { acc + x }));
    let words = map(xs, fn(x: int) -> str { if x % 2 == 0 { "even" } else { "odd" } });
    println(fold(words, "", fn(acc, w) { acc + w + " " }));

    println("first square over 5:", unwrap_or(find(squares, fn(x) { x > 5 }), -1));
    println("first square over 50:", unwrap_or(find(squares, fn(x) { x > 50 }), -1));

    // Values of generic types compare structurally when their contents can.
    println(Some(Pair { first: 1, second: "a" }) == Some(Pair { first: 1, second: "a" }));
}
