// The prelude: definitions every Aja program can use without importing them:
// `Option`, `Result`, `Iter`, and `List`.
// Their variants are in scope by themselves, so `Some(1)` means
// `Option::Some(1)`, and `Some`, `None`, `Ok`, and `Err` can't be used as
// other names.

// A value that may be absent. Aja has no null: a function that might not have
// a value to give returns an `Option`.
enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    pub fn is_some(self) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    pub fn is_none(self) -> bool {
        match self {
            Some(_) => false,
            None => true,
        }
    }

    // The value, or `default` if there is none.
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Some(x) => x,
            None => default,
        }
    }

    // `f` applied to the value, if there is one.
    pub fn map<U>(self, f: (T) -> U) -> Option<U> {
        match self {
            Some(x) => Some(f(x)),
            None => None,
        }
    }

    // `f` applied to the value, if there is one, for an `f` that may itself
    // have nothing to give.
    pub fn and_then<U>(self, f: (T) -> Option<U>) -> Option<U> {
        match self {
            Some(x) => f(x),
            None => None,
        }
    }

    // This option if it has a value, or else `other`.
    pub fn or(self, other: Option<T>) -> Option<T> {
        match self {
            Some(x) => Some(x),
            None => other,
        }
    }

    // The value, if there is one, as an `Iter`, so `for x in opt { ... }`
    // runs once or not at all.
    pub fn iter(self) -> Iter<T> {
        match self {
            Some(x) => Iter::once(x),
            None => Iter::empty(),
        }
    }

    // The value as an `Ok`, or `Err(error)` if there is none.
    pub fn ok_or<E>(self, error: E) -> Result<T, E> {
        match self {
            Some(x) => Ok(x),
            None => Err(error),
        }
    }
}

// The result of something that can fail: a value, or an error saying why.
// `expr?` gives the value inside an `Ok`, or returns the `Err` from the
// function it's in.
enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    pub fn is_ok(self) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    pub fn is_err(self) -> bool {
        match self {
            Ok(_) => false,
            Err(_) => true,
        }
    }

    // The value, or `default` if this is an error.
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Ok(x) => x,
            Err(_) => default,
        }
    }

    // `f` applied to the value, leaving an error as it is.
    pub fn map<U>(self, f: (T) -> U) -> Result<U, E> {
        match self {
            Ok(x) => Ok(f(x)),
            Err(e) => Err(e),
        }
    }

    // `f` applied to the error, leaving a value as it is: how one kind of
    // error is turned into another, for `?`.
    pub fn map_err<F>(self, f: (E) -> F) -> Result<T, F> {
        match self {
            Ok(x) => Ok(x),
            Err(e) => Err(f(e)),
        }
    }

    // `f` applied to the value, for an `f` that can fail too.
    pub fn and_then<U>(self, f: (T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Ok(x) => f(x),
            Err(e) => Err(e),
        }
    }

    // The value as a `Some`, or `None` if this is an error.
    pub fn ok(self) -> Option<T> {
        match self {
            Ok(x) => Some(x),
            Err(_) => None,
        }
    }
}

// A sequence of values, produced one at a time: what a `for` loop goes
// over. `for x in it { ... }` takes an `Iter`, or any value whose type has
// a method `iter(self) -> Iter<T>`.
//
// An `Iter` is used up as it goes: each value comes out once, and a copy of
// an `Iter` shares its position. Methods like `map` and `filter` make a new
// `Iter` that draws from this one as it is used, so nothing is computed
// until something asks for values.
struct Iter<T> {
    // Gives the next value, or `None` when there are no more.
    step: () -> Option<T>,
}

impl<T> Iter<T> {
    // An `Iter` that calls `next` for each value until it returns `None`.
    // `next` usually captures a `var` to keep its place.
    pub fn new(next: () -> Option<T>) -> Iter<T> {
        Iter { step: next }
    }

    // The ints from `start` up to, but not including, `end`. `start..end`
    // means the same.
    pub fn range(start: int, end: int) -> Iter<int> {
        var i = start;
        Iter::new(fn() -> Option<int> {
            if i < end {
                i = i + 1;
                Some(i - 1)
            } else {
                None
            }
        })
    }

    // An `Iter` with no values.
    pub fn empty() -> Iter<T> {
        Iter::new(fn() -> Option<T> { None })
    }

    // An `Iter` with one value.
    pub fn once(value: T) -> Iter<T> {
        var done = false;
        Iter::new(fn() -> Option<T> {
            if done {
                None
            } else {
                done = true;
                Some(value)
            }
        })
    }

    // The next value, or `None` if there are no more.
    pub fn next(self) -> Option<T> {
        self.step()
    }

    // `f` applied to each value.
    pub fn map<U>(self, f: (T) -> U) -> Iter<U> {
        Iter::new(fn() -> Option<U> { self.next().map(f) })
    }

    // The values for which `keep` is true.
    pub fn filter(self, keep: (T) -> bool) -> Iter<T> {
        Iter::new(fn() -> Option<T> {
            for x in self {
                if keep(x) {
                    return Some(x);
                }
            }
            None
        })
    }

    // The first `n` values, or all of them if there are fewer.
    pub fn take(self, n: int) -> Iter<T> {
        var left = n;
        Iter::new(fn() -> Option<T> {
            if left <= 0 {
                None
            } else {
                left = left - 1;
                self.next()
            }
        })
    }

    // The values after the first `n`.
    pub fn skip(self, n: int) -> Iter<T> {
        var skipped = false;
        Iter::new(fn() -> Option<T> {
            if !skipped {
                skipped = true;
                for _ in 0..n {
                    self.next();
                }
            }
            self.next()
        })
    }

    // This `Iter`'s values, then `other`'s.
    pub fn chain(self, other: Iter<T>) -> Iter<T> {
        Iter::new(fn() -> Option<T> {
            match self.next() {
                Some(x) => Some(x),
                None => other.next(),
            }
        })
    }

    // Combine the values into one, starting from `initial`: `f(f(initial,
    // a), b)` for the values `a` and `b`.
    pub fn fold<A>(self, initial: A, f: (A, T) -> A) -> A {
        var acc = initial;
        for x in self {
            acc = f(acc, x);
        }
        acc
    }

    // How many values there are.
    pub fn count(self) -> int {
        var n = 0;
        for _ in self {
            n = n + 1;
        }
        n
    }

    // The last value, or `None` if there are none.
    pub fn last(self) -> Option<T> {
        var last = None;
        for x in self {
            last = Some(x);
        }
        last
    }

    // The first value for which `pred` is true, if any.
    pub fn find(self, pred: (T) -> bool) -> Option<T> {
        for x in self {
            if pred(x) {
                return Some(x);
            }
        }
        None
    }

    // Whether `pred` is true for some value. It stops at the first one.
    pub fn any(self, pred: (T) -> bool) -> bool {
        for x in self {
            if pred(x) {
                return true;
            }
        }
        false
    }

    // Whether `pred` is true for every value. It stops at the first that
    // isn't.
    pub fn all(self, pred: (T) -> bool) -> bool {
        for x in self {
            if !pred(x) {
                return false;
            }
        }
        true
    }
}

impl<T> Iter<T> {
    // The values left, in a list.
    pub fn collect(self) -> List<T> {
        var list = [];
        for x in self {
            list = list.push(x);
        }
        list
    }
}

// A sequence of values, all of one type: `[1, 2, 3]` is a `List<int>`.
//
// A list never changes. Methods like `push` and `set` give a new list and
// leave the old one as it was, so a list can be passed around without
// anything changing it underneath you. The new list shares most of its
// memory with the old one, so making one costs about as much as changing a
// value in place would: reading, replacing, or adding a value takes a
// handful of steps whatever the list's length.
//
// `xs[i]` is the value at index `i`, counting from 0; it stops the program if
// there is none, so use `xs.get(i)` when `i` might be out of range.
native struct List<T>;

impl<T> List<T> {
    // How many values it holds.
    pub native fn len(self) -> int;

    // This list with `value` added at the end.
    pub native fn push(self, value: T) -> List<T>;

    // This list with the value at `index` replaced by `value`. Stops the
    // program if `index` is out of range.
    pub native fn set(self, index: int, value: T) -> List<T>;

    // This list without its last value (or empty, if it is).
    pub native fn drop_last(self) -> List<T>;

    // This list's values, then `other`'s.
    pub native fn concat(self, other: List<T>) -> List<T>;

    // The values from index `start` up to, but not including, `end`. Stops
    // the program unless `0 <= start <= end <= len`.
    pub native fn slice(self, start: int, end: int) -> List<T>;

    pub fn is_empty(self) -> bool {
        self.len() == 0
    }

    // The value at `index`, or `None` if it is out of range.
    pub fn get(self, index: int) -> Option<T> {
        if 0 <= index && index < self.len() {
            Some(self[index])
        } else {
            None
        }
    }

    pub fn first(self) -> Option<T> {
        self.get(0)
    }

    pub fn last(self) -> Option<T> {
        self.get(self.len() - 1)
    }

    // The values in order, for a `for` loop: `for x in xs { ... }`.
    pub fn iter(self) -> Iter<T> {
        var i = 0;
        Iter::new(fn() -> Option<T> {
            if i < self.len() {
                i = i + 1;
                Some(self[i - 1])
            } else {
                None
            }
        })
    }

    // `f` applied to each value.
    pub fn map<U>(self, f: (T) -> U) -> List<U> {
        var out = [];
        for x in self {
            out = out.push(f(x));
        }
        out
    }

    // The values for which `keep` is true.
    pub fn filter(self, keep: (T) -> bool) -> List<T> {
        var out = [];
        for x in self {
            if keep(x) {
                out = out.push(x);
            }
        }
        out
    }

    // Combine the values into one, starting from `initial` (see `Iter::fold`).
    pub fn fold<A>(self, initial: A, f: (A, T) -> A) -> A {
        self.iter().fold(initial, f)
    }

    // The first value for which `pred` is true, if any.
    pub fn find(self, pred: (T) -> bool) -> Option<T> {
        self.iter().find(pred)
    }

    // Whether `pred` is true for some value.
    pub fn any(self, pred: (T) -> bool) -> bool {
        self.iter().any(pred)
    }

    // Whether `pred` is true for every value.
    pub fn all(self, pred: (T) -> bool) -> bool {
        self.iter().all(pred)
    }

    // The values in the opposite order.
    pub fn reverse(self) -> List<T> {
        var out = [];
        var i = self.len();
        while i > 0 {
            i = i - 1;
            out = out.push(self[i]);
        }
        out
    }

    // A list of `count` copies of `value`.
    pub fn repeat(value: T, count: int) -> List<T> {
        var out = [];
        for _ in 0..count {
            out = out.push(value);
        }
        out
    }
}

// ---- Methods on the built-in types --------------------------------------------

// Text, as UTF-8. A string never changes: methods like `trim` and `replace`
// give a new string.
//
// Positions and lengths count characters (Unicode code points), not bytes,
// so `"héllo".len()` is 5 and `"héllo".slice(1, 2)` is "é". Finding the
// character at a position takes time in proportion to the position, so
// code that goes through a string one character at a time should loop over
// `chars()` rather than call `slice` for each position.
//
// A string can hold expressions, which are turned into strings and put in
// its place: `"{name} is {age} years old"`. Write `\{` for a literal brace.
impl str {
    // How many characters it holds.
    pub native fn len(self) -> int;

    // How many bytes its UTF-8 encoding takes.
    pub native fn byte_len(self) -> int;

    pub fn is_empty(self) -> bool {
        self == ""
    }

    // Itself, so a string can be used wherever a `to_str` method is wanted.
    pub fn to_str(self) -> str {
        self
    }

    // ---- Searching ----

    pub native fn contains(self, part: str) -> bool;

    pub native fn starts_with(self, prefix: str) -> bool;

    pub native fn ends_with(self, suffix: str) -> bool;

    // The position of the first `part` in it, if there is one.
    pub fn find(self, part: str) -> Option<int> {
        let i = self.index_of(part);
        if i < 0 {
            None
        } else {
            Some(i)
        }
    }

    // The position of the first `part`, or -1.
    native fn index_of(self, part: str) -> int;

    // ---- Pieces ----

    // The characters from position `start` up to, but not including, `end`.
    // Stops the program unless `0 <= start <= end <= len`.
    pub native fn slice(self, start: int, end: int) -> str;

    // Each character, as a string of its own.
    pub native fn chars(self) -> List<str>;

    // The pieces between each `separator`: `"a,b,,c".split(",")` is
    // `["a", "b", "", "c"]`. An empty separator splits it into characters.
    pub native fn split(self, separator: str) -> List<str>;

    // Its lines, without their line endings (`\n` or `\r\n`). A newline at
    // the very end doesn't start another, empty line.
    pub native fn lines(self) -> List<str>;

    // The words in it: the pieces between runs of whitespace, so none is
    // empty.
    pub native fn words(self) -> List<str>;

    // ---- New strings ----

    // Without whitespace at the start and end.
    pub native fn trim(self) -> str;

    pub native fn trim_start(self) -> str;

    pub native fn trim_end(self) -> str;

    pub native fn to_upper(self) -> str;

    pub native fn to_lower(self) -> str;

    // With every `from` replaced by `to`. An empty `from` changes nothing.
    pub native fn replace(self, from: str, to: str) -> str;

    // `count` copies of it, one after another (none if `count` <= 0).
    pub native fn repeat(self, count: int) -> str;

    // The strings in `parts`, with this one between each two:
    // `", ".join(["a", "b", "c"])` is "a, b, c".
    pub native fn join(self, parts: List<str>) -> str;

    // ---- Conversions ----

    // The int it spells, as in `"-42"`, or `None` if it isn't one.
    // Whitespace around it isn't allowed; `trim` it first if there might be
    // some.
    pub fn parse_int(self) -> Option<int> {
        if self.is_int() {
            Some(self.to_int_unchecked())
        } else {
            None
        }
    }

    // The float it spells, as in `"2.5"`, `"-1e3"`, or `"7"`, or `None`.
    pub fn parse_float(self) -> Option<float> {
        if self.is_float() {
            Some(self.to_float_unchecked())
        } else {
            None
        }
    }

    native fn is_int(self) -> bool;
    native fn to_int_unchecked(self) -> int;
    native fn is_float(self) -> bool;
    native fn to_float_unchecked(self) -> float;
}

impl int {
    // It in decimal, as `println` shows it: `-42`.
    pub native fn to_str(self) -> str;

    // It as a float, as near as a float can be.
    pub native fn to_float(self) -> float;

    pub fn abs(self) -> int {
        if self < 0 {
            -self
        } else {
            self
        }
    }

    pub fn min(self, other: int) -> int {
        if other < self {
            other
        } else {
            self
        }
    }

    pub fn max(self, other: int) -> int {
        if other > self {
            other
        } else {
            self
        }
    }

    // It, moved into the range `low..=high`.
    pub fn clamp(self, low: int, high: int) -> int {
        self.max(low).min(high)
    }

    // It to the power `exponent`, which must not be negative. Stops the
    // program if the result is too large for an int.
    pub native fn pow(self, exponent: int) -> int;
}

impl float {
    // It as `println` shows it: `2.5`, `1.0`, `inf`, or `NaN`.
    pub native fn to_str(self) -> str;

    // It without its fractional part, rounded towards zero: `-2.7` gives
    // `-2`. Stops the program if it is NaN or too large for an int.
    pub native fn to_int(self) -> int;

    pub native fn floor(self) -> float;

    pub native fn ceil(self) -> float;

    // The nearest whole number, with halves rounded away from zero.
    pub native fn round(self) -> float;

    pub native fn sqrt(self) -> float;

    pub native fn is_nan(self) -> bool;

    pub fn abs(self) -> float {
        if self < 0.0 {
            -self
        } else {
            self
        }
    }

    pub fn min(self, other: float) -> float {
        if other < self {
            other
        } else {
            self
        }
    }

    pub fn max(self, other: float) -> float {
        if other > self {
            other
        } else {
            self
        }
    }
}

impl bool {
    // "true" or "false".
    pub fn to_str(self) -> str {
        if self {
            "true"
        } else {
            "false"
        }
    }
}
