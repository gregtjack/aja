// The standard library's intrinsics: the few operations it can't write in
// Aja, which each backend implements. Only the standard library can import
// this module.
//
// An intrinsic takes and returns only `int`, `float`, `bool`, `str`, `void`,
// and lists of those, so a backend can implement it without knowing how
// Aja's structs and enums are laid out; the library builds those. One that can fail
// records how it went, which `status` (and `error_message`) give straight
// after the call.

// How the last intrinsic that can fail went: 0 if it succeeded, 1 at the end
// of input, or an error code (see `error` in `std::io`).
pub native fn status() -> int;

// What went wrong in the last intrinsic that failed.
pub native fn error_message() -> str;

// A line from file descriptor `fd`, without its line ending.
pub native fn read_line(fd: int) -> str;

// Everything left to read from `fd`.
pub native fn read_all(fd: int) -> str;

pub native fn write(fd: int, text: str);

// Write out anything buffered for `fd`.
pub native fn flush(fd: int);

// ---- The file system --------------------------------------------------------
//
// Paths are relative to the program's working directory.

// What is at `path`: 0 if nothing is (or it can't be seen), 1 a file, 2 a
// directory, 3 something else. Symbolic links are followed. Never fails.
pub native fn path_kind(path: str) -> int;

// The size of the file at `path`, in bytes.
pub native fn file_size(path: str) -> int;

pub native fn read_file(path: str) -> str;

// The lines of the file at `path`, without their line endings.
pub native fn read_file_lines(path: str) -> List<str>;

// Write `text` to the file at `path`, creating it if it doesn't exist, and
// either replacing what it had or, if `append`, adding to the end.
pub native fn write_file(path: str, text: str, append: bool);

// The names of the entries in the directory at `path`, sorted.
pub native fn read_dir(path: str) -> List<str>;

// Create the directory at `path`, and, if `all`, any parents it is missing
// (in which case it is fine if it exists already).
pub native fn create_dir(path: str, all: bool);

pub native fn remove_file(path: str);

// Remove the directory at `path`, which must be empty unless `all`, in
// which case everything in it is removed too.
pub native fn remove_dir(path: str, all: bool);

// Move `from` to `to`, replacing a file there.
pub native fn rename(from: str, to: str);

// Copy the file at `from` to `to`, replacing a file there.
pub native fn copy_file(from: str, to: str);

// ---- Time (`std::time`) -------------------------------------------------------

// Nanoseconds on a clock that only goes forward, counted from a moment
// around when the program started. Never fails.
pub native fn monotonic_nanos() -> int;

// Sleep the calling task for `nanos` nanoseconds, which must be 0 or more,
// while the others run.
pub native fn sleep_nanos(nanos: int);

// ---- TCP (`std::net`) ---------------------------------------------------------
//
// A socket is an `int` handle into the runtime's table, never reused, so a
// closed one fails with status 15 (not connected). Each of these blocks
// only its task.

// A listener bound to `addr`, such as "127.0.0.1:8080".
pub native fn tcp_listen(addr: str) -> int;

// The next connection made to listener `id`, waiting for one.
pub native fn tcp_accept(id: int) -> int;

// A connection to `addr`, which may need resolving: "localhost:80".
pub native fn tcp_connect(addr: str) -> int;

// The next line from stream `id`, without its line ending. At the end of
// the stream the status is 1.
pub native fn tcp_read_line(id: int) -> str;

// Everything left to read from stream `id`, up to its end.
pub native fn tcp_read_all(id: int) -> str;

// The next `n` bytes from stream `id`, or fewer if it ends first ("" at
// its end). Fails with status 4 if they aren't UTF-8.
pub native fn tcp_read(id: int, n: int) -> str;

// Send all of `text` on stream `id`.
pub native fn tcp_write(id: int, text: str);

// Tell the other end of stream `id` that nothing more is coming.
pub native fn tcp_close_write(id: int);

// Close socket `id`. Closing one that is already closed does nothing.
pub native fn tcp_close(id: int);

pub native fn tcp_local_addr(id: int) -> str;

pub native fn tcp_peer_addr(id: int) -> str;
