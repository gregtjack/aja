// The program's environment: the arguments it was run with, and its
// environment variables.
//
//     import std::env;
//
//     fn main() {
//         // aja greet.aja Ada  ->  Hello, Ada!
//         let name = env::args().first().unwrap_or("stranger");
//         let greeting = env::get("GREETING").unwrap_or("Hello");
//         println("{greeting}, {name}!");
//     }

import std::native;

// The arguments after the file being run: for `aja server.aja 8080 -v`,
// `["8080", "-v"]`.
pub fn args() -> List<str> {
    native::args()
}

// The environment variable `name`, or `None` if it isn't set, or isn't
// UTF-8 text.
pub fn get(name: str) -> Option<str> {
    if native::has_env(name) {
        Some(native::env_var(name))
    } else {
        None
    }
}
